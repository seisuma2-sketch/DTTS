<Page
    x:Class="DTTS.Views.LobbyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:net="using:DTTS.Services.Network"
    xmlns:settings="using:DTTS.Services.Settings"
    xmlns:vm="using:DTTS.ViewModels"
    xmlns:views="using:DTTS.Views"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundDeepBrush}"
    Loaded="OnPageLoaded">

    <Page.Resources>
        <!-- パネル見出しの丸いアイコン -->
        <Style x:Key="LobbyIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="{StaticResource AppAccentSubtleBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- 広い画面：「部屋を作る」と「部屋を探す」を左右に。狭い画面：上下に並べる -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLobby">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1060" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLobby">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="JoinColumnDef.Width" Value="0" />
                        <Setter Target="EntryGrid.ColumnSpacing" Value="0" />
                        <Setter Target="JoinPanel.(Grid.Column)" Value="0" />
                        <Setter Target="JoinPanel.(Grid.Row)" Value="1" />
                        <Setter Target="JoinPanel.Margin" Value="0,20,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Background="{StaticResource AppPageBackgroundBrush}" IsHitTestVisible="False">
            <Ellipse Width="460" Height="460" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-140,0,0" Fill="{StaticResource AppAccentBrush}" Opacity="0.06" />
        </Grid>

        <Grid Padding="32,24,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ヘッダー：戻る / 見出し -->
            <Grid Grid.Row="0" Margin="0,0,0,18" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource AppBackButtonStyle}" AutomationProperties.Name="タイトルへ戻る" Command="{x:Bind ViewModel.GoBackCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="タイトルへ戻る（Esc）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="タイトル" FontSize="13" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Style="{StaticResource LobbyIconBadgeStyle}">
                        <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="{StaticResource AppAccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="通信対戦ロビー" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Bluetooth LE で近くの人と、4人までローカル対戦できます。足りない席は NPC が入ります" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 案内メッセージ（検索中・接続中・エラーなど） -->
            <Border
                Grid.Row="1"
                Margin="0,0,12,16"
                MaxWidth="1100"
                HorizontalAlignment="Stretch"
                CornerRadius="12"
                Padding="14,10"
                Background="{StaticResource AppAccentSubtleBrush}"
                BorderBrush="{StaticResource AppAccentBrush}"
                BorderThickness="1"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="SearchProgressRing" Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}" />
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <Grid MaxWidth="1100" HorizontalAlignment="Stretch">

                    <!-- ===================== 状態1：部屋に入る前（作る／探す） ===================== -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsInRoom, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                        <!-- プレイヤー設定（名前・アイコン） -->
                        <Border Style="{StaticResource AppPanelStyle}" Padding="18,14">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- アイコンプレビュー -->
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AppAccentSubtleBrush}" BorderBrush="{StaticResource AppAccentBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon
                                            Glyph="{x:Bind views:LobbyPage.IconGlyphById(ViewModel.SelectedIconId), Mode=OneWay}"
                                            FontSize="22"
                                            Foreground="{StaticResource AppAccentBrush}"
                                            Visibility="{x:Bind views:LobbyPage.NoCustomAvatar(ViewModel.CustomAvatarPath), Mode=OneWay}" />
                                        <Ellipse Width="50" Height="50" Visibility="{x:Bind views:LobbyPage.HasCustomAvatar(ViewModel.CustomAvatarPath), Mode=OneWay}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind views:LobbyPage.AvatarImageSource(ViewModel.CustomAvatarPath), Mode=OneWay}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Header="あなたの名前"
                                            PlaceholderText="プレイヤー名"
                                            Text="{x:Bind ViewModel.PlayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            MaxLength="16"
                                            CornerRadius="8" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                            <Button Content="画像アイコンを選ぶ" Click="OnPickAvatarClicked" CornerRadius="8" />
                                            <Button
                                                Content="解除"
                                                Command="{x:Bind ViewModel.ClearCustomAvatarCommand}"
                                                Visibility="{x:Bind views:LobbyPage.HasCustomAvatar(ViewModel.CustomAvatarPath), Mode=OneWay}"
                                                CornerRadius="8" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailablePlayerIcons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="settings:PlayerIconInfo">
                                                <Button
                                                    Tag="{x:Bind Id}"
                                                    Click="OnPlayerIconClicked"
                                                    ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                    Width="34"
                                                    Height="34"
                                                    Padding="0"
                                                    CornerRadius="17"
                                                    Background="#1FFFFFFF"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{x:Bind views:LobbyPage.HexToBrush(AccentHex)}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="EntryGrid" ColumnSpacing="20" RowSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="JoinColumnDef" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 左：部屋を作る（ホスト） -->
                        <Border Style="{StaticResource AppPanelStyle}" Padding="22,20" VerticalAlignment="Top">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Style="{StaticResource LobbyIconBadgeStyle}">
                                        <FontIcon Glyph="&#xE80F;" FontSize="17" Foreground="{StaticResource AppAccentBrush}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="部屋を作る" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="あなたがホストになって、参加者を待ちます" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBox Header="部屋の名前" Text="{x:Bind ViewModel.HostRoomName, Mode=TwoWay}" CornerRadius="10" />

                                <!-- 参加 PIN 設定 -->
                                <Border CornerRadius="10" Padding="12,10" Background="{StaticResource AppInsetBrush}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Content="参加 PIN を求める" IsChecked="{x:Bind ViewModel.UseJoinPin, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HostJoinPin, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Foreground="{StaticResource AppAccentBrush}" Visibility="{x:Bind ViewModel.UseJoinPin, Mode=OneWay}" />
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.RegenerateJoinPinCommand}" Visibility="{x:Bind ViewModel.UseJoinPin, Mode=OneWay}" ToolTipService.ToolTip="PIN を作り直す" Padding="8,4" CornerRadius="8" Background="#1FFFFFFF">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- テーマ＆ルール設定とプリセット保存 -->
                                <Border CornerRadius="12" Padding="14,12" Background="{StaticResource AppInsetBrush}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="部屋のテーマ・ルール設定" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />

                                        <!-- テーマカラー -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="テーマカラー" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableThemeColors}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="settings:ThemeColorInfo">
                                                        <Button
                                                            Tag="{x:Bind Color}"
                                                            Click="OnThemeSwatchClicked"
                                                            ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                            Width="26"
                                                            Height="26"
                                                            Padding="0"
                                                            CornerRadius="13"
                                                            Background="{x:Bind views:LobbyPage.HexToBrush(AccentHex)}"
                                                            BorderBrush="#88FFFFFF"
                                                            BorderThickness="1.5" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 革命時の背景色 -->
                                        <ComboBox
                                            Header="革命時の卓背景色"
                                            ItemsSource="{x:Bind ViewModel.AvailableRevolutionBgColors}"
                                            SelectedIndex="{x:Bind ViewModel.SelectedRevolutionBgIndex, Mode=TwoWay}"
                                            DisplayMemberPath="DisplayName"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="8" />

                                        <!-- ルール概要とプリセット -->
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.RulesSummaryText, Mode=OneWay}"
                                                    FontSize="12"
                                                    Foreground="{StaticResource AppTextSecondaryBrush}"
                                                    TextWrapping="Wrap"
                                                    VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="詳細ルール編集" Command="{x:Bind ViewModel.OpenRuleSettingsCommand}" Padding="10,4" FontSize="11" CornerRadius="8" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="シンプル" Command="{x:Bind ViewModel.ApplyBuiltinPresetCommand}" CommandParameter="simple" Padding="10,4" FontSize="11" CornerRadius="8" />
                                                <Button Content="標準" Command="{x:Bind ViewModel.ApplyBuiltinPresetCommand}" CommandParameter="default" Padding="10,4" FontSize="11" CornerRadius="8" />
                                                <Button Content="全部盛り" Command="{x:Bind ViewModel.ApplyBuiltinPresetCommand}" CommandParameter="all" Padding="10,4" FontSize="11" CornerRadius="8" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- プリセットとして保存 -->
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                PlaceholderText="プリセット名（例：夜更かし卓）"
                                                Text="{x:Bind ViewModel.PresetNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                MinWidth="0"
                                                CornerRadius="8" />
                                            <Button Grid.Column="1" Content="保存" Command="{x:Bind ViewModel.SaveRoomPresetCommand}" CornerRadius="8" Padding="12,6" />
                                        </Grid>

                                        <!-- 保存済みマイプリセット -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SavedPresets}" Visibility="{x:Bind views:LobbyPage.CountToVisibility(ViewModel.SavedPresets.Count), Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="settings:CustomRulePreset">
                                                    <Grid ColumnSpacing="6" Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            Tag="{x:Bind}"
                                                            Click="OnApplyCustomPresetClicked"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="10,5"
                                                            CornerRadius="8"
                                                            Background="#1FFFFFFF">
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                        <Button
                                                            Grid.Column="1"
                                                            Tag="{x:Bind}"
                                                            Click="OnDeleteCustomPresetClicked"
                                                            ToolTipService.ToolTip="削除"
                                                            Padding="8,5"
                                                            CornerRadius="8"
                                                            Background="#18FF4040">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#E07A84" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Button
                                    Command="{x:Bind ViewModel.HostRoomCommand}"
                                    AutomationProperties.Name="部屋を作成する"
                                    HorizontalAlignment="Stretch"
                                    Height="50"
                                    CornerRadius="25"
                                    Background="{StaticResource AppAccentGradientBrush}"
                                    Foreground="{StaticResource AppOnAccentBrush}"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE710;" FontSize="15" />
                                        <TextBlock Text="部屋を作成する" FontWeight="Bold" FontSize="15" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 右：部屋を探す／IP で参加（クライアント） -->
                        <Border x:Name="JoinPanel" Grid.Column="1" Style="{StaticResource AppPanelStyle}" Padding="22,20" VerticalAlignment="Top">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LobbyIconBadgeStyle}">
                                            <FontIcon Glyph="&#xE721;" FontSize="17" Foreground="{StaticResource AppAccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="部屋を探して参加" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="見つかった部屋をクリックすると参加します" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Button
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.SearchRoomsCommand}"
                                        AutomationProperties.Name="部屋を探す"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="16"
                                        Padding="12,6"
                                        Background="#1FFFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="もう一度 Bluetooth LE で近くの部屋を探します">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource AppAccentBrush}" />
                                            <TextBlock Text="再検索" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 見つかった部屋の一覧 -->
                                <Border MinHeight="120" MaxHeight="220" CornerRadius="12" Background="{StaticResource AppInsetBrush}" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="8">
                                    <Grid>
                                        <StackPanel
                                            Spacing="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.DiscoveredRooms.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibleConverter}}">
                                            <FontIcon Glyph="&#xE701;" FontSize="22" Foreground="{StaticResource AppTextMutedBrush}" />
                                            <TextBlock Text="まだ部屋が見つかっていません" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="相手が部屋を作ってから「再検索」を押してください" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>

                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.DiscoveredRooms}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="net:RoomInfo">
                                                        <Button
                                                            Tag="{x:Bind}"
                                                            Click="OnJoinRoomClicked"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Margin="0,3"
                                                            Padding="12,10"
                                                            CornerRadius="10"
                                                            Background="#CC1E2533"
                                                            BorderBrush="#2EFFFFFF"
                                                            BorderThickness="1">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock Text="{x:Bind RoomName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind views:LobbyPage.RoomCaption(HostName, OpenSeats, IsPlaying)}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" CornerRadius="12" Padding="10,3" Background="{StaticResource AppAccentBrush}" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <TextBlock Text="参加" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppOnAccentBrush}" />
                                                                        <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{StaticResource AppOnAccentBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- 参加 PIN 入力 -->
                                <TextBox Header="参加 PIN（設定されている場合）" PlaceholderText="6桁のPIN（不要なら空）" Text="{x:Bind ViewModel.JoinPinInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="10" MaxLength="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>

                    <!-- ===================== 状態2：待合室（席の状況・開始） ===================== -->
                    <Border Style="{StaticResource AppPanelStyle}" Padding="24,22" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.IsInRoom, Mode=OneWay}">
                        <StackPanel Spacing="20">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LobbyIconBadgeStyle}">
                                    <FontIcon Glyph="&#xE80F;" FontSize="17" Foreground="{StaticResource AppAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.RoomTitle, Mode=OneWay}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind views:LobbyPage.RoomRoleText(ViewModel.IsHost), Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.LeaveRoomCommand}"
                                    VerticalAlignment="Center"
                                    CornerRadius="16"
                                    Padding="12,6"
                                    Background="#1FFFFFFF"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE89B;" FontSize="12" Foreground="#E07A84" />
                                        <TextBlock Text="部屋から退出" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- ホスト用：Bluetooth LE 公開案内 & 参加 PIN 共有バー -->
                            <Border CornerRadius="12" Padding="14,10" Background="{StaticResource AppInsetBrush}" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE702;" FontSize="13" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Bluetooth LE で近くのプレイヤーへ公開中です（相手は「部屋を探す」から参加できます）" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.UseJoinPin, Mode=OneWay}">
                                        <TextBlock Text="参加 PIN：" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.HostJoinPin, Mode=OneWay}" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                        <Button Click="OnCopyPinClicked" Padding="6,2" CornerRadius="6" Background="#1FFFFFFF" ToolTipService.ToolTip="PIN をコピー">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4つの席：人は人のアイコン、NPC はロボットのアイコン。ホストの席には印を付ける -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Seats}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="186" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="net:SeatInfo">
                                        <Border Margin="6" CornerRadius="14" Padding="14,12" Background="{StaticResource AppInsetBrush}" BorderBrush="{x:Bind views:LobbyPage.SeatBorder(Kind)}" BorderThickness="1.5">
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Border CornerRadius="10" Padding="8,2" Background="#1FFFFFFF" HorizontalAlignment="Left">
                                                        <TextBlock Text="{x:Bind views:LobbyPage.SeatLabel(SeatId)}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="10" Padding="8,2" Background="#E9B93A" HorizontalAlignment="Right" Visibility="{x:Bind IsHost}">
                                                        <TextBlock Text="ホスト" FontSize="11" FontWeight="Bold" Foreground="#2B1E00" />
                                                    </Border>
                                                    <Border CornerRadius="10" Padding="8,2" Background="#28A745" HorizontalAlignment="Right" Visibility="{x:Bind views:LobbyPage.IsReadyBadgeVisible(Kind, IsReady)}">
                                                        <TextBlock Text="準備OK" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <Border CornerRadius="10" Padding="8,2" Background="#44FFFFFF" HorizontalAlignment="Right" Visibility="{x:Bind IsLocked}">
                                                        <TextBlock Text="NPC専用" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                </Grid>
                                                <Border Grid.Row="1" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" Background="{x:Bind views:LobbyPage.SeatIconBackground(Kind)}">
                                                    <FontIcon Glyph="{x:Bind views:LobbyPage.SeatGlyph(Kind, AvatarIcon)}" FontSize="20" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Row="2" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind views:LobbyPage.SeatKindText(Kind, IsConnected)}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <!-- ホスト用：席管理ボタン（外す / NPC切替） -->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Loaded="OnHostSeatControlLoaded" Visibility="{x:Bind views:LobbyPage.CanLockSeatVisible(IsHost)}">
                                                    <Button Tag="{x:Bind}" Click="OnToggleSeatNpcClicked" Padding="8,3" CornerRadius="8" Background="#1FFFFFFF" Visibility="{x:Bind views:LobbyPage.CanLockSeatVisible(IsHost)}">
                                                        <TextBlock Text="{x:Bind views:LobbyPage.SeatLockButtonLabel(IsLocked)}" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                                    </Button>
                                                    <Button Tag="{x:Bind}" Click="OnKickSeatClicked" Padding="8,3" CornerRadius="8" Background="#26FF4040" Visibility="{x:Bind views:LobbyPage.CanKickSeatVisible(IsHost, Kind)}">
                                                        <TextBlock Text="外す" FontSize="10" Foreground="#F48A94" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ホストだけが開始できる。参加者には準備完了ボタンと待機中の案内を出す -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay}">
                                <Grid>
                                    <Border CornerRadius="30" Margin="-4" Background="{StaticResource AppAccentSubtleBrush}" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.AreAllGuestsReady, Mode=OneWay}" />
                                    <Button
                                        Command="{x:Bind ViewModel.StartGameAsHostCommand}"
                                        IsEnabled="{x:Bind ViewModel.AreAllGuestsReady, Mode=OneWay}"
                                        AutomationProperties.Name="対戦を開始する"
                                        HorizontalAlignment="Stretch"
                                        Height="56"
                                        CornerRadius="28"
                                        Background="{StaticResource AppAccentGradientBrush}"
                                        Foreground="{StaticResource AppOnAccentBrush}"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                                            <TextBlock Text="対戦を開始する" FontSize="17" FontWeight="Bold" />
                                            <TextBlock Text="（空いている席には NPC が入ります）" FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="すべての参加者が「準備完了」にすると開始できます" FontSize="12" Foreground="#E9B93A" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.AreAllGuestsReady, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsHost, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Button
                                    Command="{x:Bind ViewModel.ToggleReadyCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="48"
                                    CornerRadius="24"
                                    Background="{StaticResource AppAccentGradientBrush}"
                                    Foreground="{StaticResource AppOnAccentBrush}"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1">
                                    <TextBlock Text="{x:Bind views:LobbyPage.ReadyButtonLabel(ViewModel.IsReady), Mode=OneWay}" FontSize="15" FontWeight="Bold" />
                                </Button>
                                <Border
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Background="{StaticResource AppInsetBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsGuestWaiting, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="ホストが対戦を開始するのを待っています" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- 通信の暗号化確認コード（SAS：MITM 目視検証用） -->
                            <TextBlock
                                Text="{x:Bind ViewModel.AuthCodeSummary, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasAuthCodeSummary, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
