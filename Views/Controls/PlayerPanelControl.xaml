<UserControl
    x:Class="DTTS.Views.Controls.PlayerPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="176">

    <Grid>
        <!-- 手番の発光（テーマカラーの柔らかい光の輪）。手番のときだけ表示する -->
        <Border
            x:Name="TurnGlowOuter"
            Margin="-7"
            CornerRadius="19"
            BorderThickness="7"
            Opacity="0"
            IsHitTestVisible="False" />
        <Border
            x:Name="TurnGlowInner"
            Margin="-3"
            CornerRadius="15"
            BorderThickness="3"
            Opacity="0"
            IsHitTestVisible="False" />

        <Border
            x:Name="RootBorder"
            CornerRadius="12"
            BorderBrush="#2E3646"
            BorderThickness="1.5"
            Padding="12,9,12,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F2262E3D" Offset="0" />
                    <GradientStop Color="#F21A202C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1行目: 階級バッジ & プレイヤー名 & 手番バッジ -->
                <Grid Grid.Row="0" ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="RankBadge"
                        CornerRadius="10"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        BorderThickness="1">
                        <TextBlock
                            x:Name="RankText"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="平民" />
                    </Border>
                    <TextBlock
                        x:Name="PlayerNameText"
                        Grid.Column="1"
                        FontSize="15"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AppTextPrimaryBrush}"
                        Text="Player 1"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        x:Name="TurnBadge"
                        Grid.Column="2"
                        CornerRadius="10"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock x:Name="TurnBadgeText" FontSize="11" FontWeight="Bold" Text="手番" />
                    </Border>
                </Grid>

                <!-- 2行目: 手札（裏向きミニカード）と残り枚数。カードは5枚ずつのまとまりで並べ、10枚を超えたら2段にする -->
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 残り枚数に応じた裏向きカード（相手が出すと減っていく）。中身はコードで並べる -->
                    <StackPanel
                        x:Name="MiniBackRows"
                        Orientation="Vertical"
                        Spacing="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left" />

                    <!-- 残り枚数（数字を大きく） -->
                    <Border
                        x:Name="HandCountPill"
                        Grid.Column="1"
                        CornerRadius="9"
                        Padding="8,1,8,2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Background="#2EFFFFFF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock x:Name="HandCountText" FontSize="19" FontWeight="Bold" VerticalAlignment="Bottom" Foreground="{StaticResource AppTextPrimaryBrush}" Text="13" />
                            <TextBlock x:Name="HandCountUnit" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" Foreground="{StaticResource AppTextSecondaryBrush}" Text="枚" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3行目: 状態ステータス (ターン中 / 考え中 / パス / あがり) & スコア -->
                <Grid Grid.Row="2" MinHeight="22" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="StatusBadge"
                        CornerRadius="10"
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#2A3040">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center" Fill="#7A8293" />
                            <TextBlock
                                x:Name="StatusText"
                                FontSize="11"
                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                Text="待機中" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Text="得点" />
                        <TextBlock x:Name="ScoreText" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AppAccentBrush}" Text="+0pt" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
