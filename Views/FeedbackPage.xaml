<Page
    x:Class="DTTS.Views.FeedbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:db="using:DTTS.Services.Database"
    xmlns:vm="using:DTTS.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppPageBackgroundBrush}"
    Loaded="OnPageLoaded">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.GoBackCommand}" Style="{StaticResource AppBackButtonStyle}" Content="← タイトルへ戻る" AutomationProperties.Name="タイトルへ戻る" />
                <TextBlock Text="フィードバック ＆ 要望（オフライン対応）" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <Button Click="OnExportJsonClicked" AutomationProperties.Name="JSONエクスポート" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource ButtonCornerRadius}">
                    <TextBlock Text="JSONエクスポート..." FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </Button>
                <Button Command="{x:Bind ViewModel.SyncPendingCommand}" AutomationProperties.Name="クラウドへ同期" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource ButtonCornerRadius}">
                    <TextBlock Text="クラウドへ同期" FontSize="13" Foreground="{StaticResource AppAccentBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 同期先 Webhook URL 設定＆ステータス -->
        <Border Grid.Row="1" CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="同期先 Webhook URL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBox
                        Grid.Column="1"
                        PlaceholderText="https://example.com/webhook（空欄でローカル保存のみ）"
                        Text="{x:Bind ViewModel.WebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="同期先 Webhook URL" />
                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.SaveWebhookUrlCommand}"
                        Background="{StaticResource AppAccentBrush}"
                        Foreground="{StaticResource AppOnAccentBrush}"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Padding="14,6">
                        <TextBlock Text="保存" FontSize="12" FontWeight="Bold" />
                    </Button>
                </Grid>
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{StaticResource AppAccentBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- メインチャットタイムライン -->
        <Border Grid.Row="2" CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="フィードバックや要望を書き込むとローカルDBに安全に蓄積されます。Webhook URL（https://）を設定すると「クラウドへ同期」から送信できます。"
                        FontSize="12"
                        Foreground="{StaticResource AppTextMutedBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FeedbackItemViewModel">
                                <!-- 右寄せ（User）の吹き出し -->
                                <Grid Margin="0,4">
                                    <Border
                                        CornerRadius="12"
                                        Padding="14,10"
                                        MaxWidth="500"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource AppAccentBrush}">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="4" Background="#30000000" Padding="6,1">
                                                    <TextBlock Text="{x:Bind CategoryText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppOnAccentBrush}" />
                                                </Border>
                                                <TextBlock Text="{x:Bind TimeText}" FontSize="10" Foreground="{StaticResource AppOnAccentBrush}" Opacity="0.8" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="10" Foreground="{StaticResource AppOnAccentBrush}" Opacity="0.7" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Message}" FontSize="14" Foreground="{StaticResource AppOnAccentBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 下部入力バー -->
        <Border Grid.Row="3" CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Padding="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- カテゴリ選択 -->
                <ComboBox
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    SelectedIndex="1"
                    AutomationProperties.Name="フィードバックカテゴリ"
                    SelectionChanged="OnCategoryChanged">
                    <ComboBoxItem Content="不具合報告" Tag="Bug" />
                    <ComboBoxItem Content="機能要望" Tag="Request" />
                    <ComboBoxItem Content="感想・その他" Tag="Comment" />
                </ComboBox>

                <!-- テキスト入力 -->
                <TextBox
                    Grid.Column="1"
                    PlaceholderText="メッセージを入力してください（最大2000文字）..."
                    Text="{x:Bind ViewModel.InputMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    MaxLength="2000"
                    AutomationProperties.Name="フィードバック本文"
                    VerticalAlignment="Center"
                    KeyDown="OnInputKeyDown" />

                <!-- 送信ボタン -->
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.SendMessageCommand}"
                    AutomationProperties.Name="フィードバックを送信"
                    Background="{StaticResource AppAccentBrush}"
                    Foreground="{StaticResource AppOnAccentBrush}"
                    CornerRadius="{StaticResource ButtonCornerRadius}"
                    Height="40"
                    Padding="20,0"
                    VerticalAlignment="Center">
                    <TextBlock Text="送信" FontWeight="Bold" FontSize="14" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
