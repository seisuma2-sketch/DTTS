<Page
    x:Class="DTTS.Views.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DTTS.ViewModels"
    xmlns:ctrl="using:DTTS.Views.Controls"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundDeepBrush}"
    Loaded="OnPageLoaded">

    <Page.Resources>
        <!-- 右カラムのサブメニュー（2×2 のグリッドボタン） -->
        <Style x:Key="TitleTileButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#CC1E2533" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <!--
            画面幅に応じた2カラム／1列の切り替え。
            広い画面：左にロゴ・カードの扇・サマリー、右にメニュー。狭い画面：上下に並べてスクロール。
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideTitle">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowTitle">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightColumnDef.Width" Value="0" />
                        <Setter Target="MenuColumn.(Grid.Column)" Value="0" />
                        <Setter Target="MenuColumn.(Grid.Row)" Value="1" />
                        <Setter Target="MenuColumn.Margin" Value="0,24,0,0" />
                        <Setter Target="HeroGrid.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 背景：左上からテーマカラーがほんのり差し込む、奥行きのあるグラデーション -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <RadialGradientBrush Center="0.28,0.42" GradientOrigin="0.28,0.42" RadiusX="0.75" RadiusY="0.95">
                    <GradientStop Color="#FF1D2738" Offset="0" />
                    <GradientStop Color="#FF131925" Offset="0.55" />
                    <GradientStop Color="#FF0C0F15" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,40" Fill="{StaticResource AppAccentBrush}" Opacity="0.07" />
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="HeroGrid" MaxWidth="1180" Padding="48,40" ColumnSpacing="56" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightColumnDef" Width="420" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============================ 左カラム ============================ -->
                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="22" VerticalAlignment="Center">
                    <!-- ロゴ・タグライン -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="DTTS" FontSize="72" FontWeight="Black" CharacterSpacing="120" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="4-Player Daifugo Tabletop Suite" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock Text="ローカルルールを自由に組み合わせて遊べる、4人対戦の大富豪" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- トランプの扇（カードはコードで並べる） -->
                    <Canvas x:Name="FanCanvas" Height="210" Width="420" HorizontalAlignment="Left" IsHitTestVisible="False" />

                    <!-- サマリーのミニカード（通算戦績・現在の設定） -->
                    <Grid ColumnSpacing="14" MaxWidth="660" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="16" Padding="16,14" Background="#B31A2130" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                                    <TextBlock Text="通算戦績" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.GamesText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="対戦数" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind ViewModel.WinRateText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="1位率" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Bind ViewModel.AveragePlaceText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="平均順位" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.StatsCaption, Mode=OneWay}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="16" Padding="16,14" Background="#B31A2130" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                                    <TextBlock Text="現在の設定" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.RulesText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="有効なルール" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind ViewModel.RoundsText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="1ゲーム" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Bind ViewModel.SpeedText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="進行スピード" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="「ルール ＆ 外見設定」で変更できます" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ============================ 右カラム：メニュー ============================ -->
                <StackPanel x:Name="MenuColumn" Grid.Column="1" Grid.Row="0" Spacing="14" VerticalAlignment="Center">
                    <!-- プライマリ：ひとりで対戦（大きなカードボタン） -->
                    <Button
                        Command="{x:Bind ViewModel.StartSinglePlayerCommand}" AutomationProperties.Name="ひとりで対戦"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="22,20"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="#55FFFFFF"
                        Background="{StaticResource AppAccentBrush}"
                        Foreground="{StaticResource AppOnAccentBrush}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="26" Background="#33FFFFFF">
                                <FontIcon Glyph="&#xE7FC;" FontSize="24" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ひとりで対戦" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="NPC 3人と、いまの設定ですぐに遊ぶ" FontSize="12" Opacity="0.85" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 通信対戦 -->
                    <Button
                        Command="{x:Bind ViewModel.OpenLobbyCommand}" AutomationProperties.Name="通信対戦（LAN）"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="20,16"
                        CornerRadius="18"
                        BorderThickness="1.5"
                        BorderBrush="{StaticResource AppAccentBrush}"
                        Background="#CC1E2533"
                        Foreground="{StaticResource AppTextPrimaryBrush}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AppAccentSubtleBrush}">
                                <FontIcon Glyph="&#xE968;" FontSize="19" Foreground="{StaticResource AppAccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="通信対戦（LAN）" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="同じネットワークの友だちと部屋を作る・参加する" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <!-- 設定・戦績・ヘルプ・フィードバック（2×2） -->
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78" />
                            <RowDefinition Height="78" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource TitleTileButtonStyle}" Command="{x:Bind ViewModel.OpenRuleSettingsCommand}" AutomationProperties.Name="ルール ＆ 外見設定">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE713;" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource AppAccentBrush}" />
                                <TextBlock Text="ルール ＆ 外見設定" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource TitleTileButtonStyle}" Command="{x:Bind ViewModel.OpenResultCommand}" AutomationProperties.Name="通算戦績 ＆ 履歴">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE9D2;" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource AppAccentBrush}" />
                                <TextBlock Text="通算戦績 ＆ 履歴" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Style="{StaticResource TitleTileButtonStyle}" Command="{x:Bind ViewModel.OpenHelpCommand}" AutomationProperties.Name="遊び方 ＆ ルール解説">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE897;" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource AppAccentBrush}" />
                                <TextBlock Text="遊び方 ＆ ルール解説" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TitleTileButtonStyle}" Command="{x:Bind ViewModel.OpenFeedbackCommand}" AutomationProperties.Name="フィードバック ＆ 要望">
                            <StackPanel Spacing="4">
                                <FontIcon Glyph="&#xE8BD;" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource AppAccentBrush}" />
                                <TextBlock Text="フィードバック ＆ 要望" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- フッター -->
                    <TextBlock Text="{x:Bind VersionText}" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource AppTextMutedBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 右上：サウンド ON/OFF（ワンクリックで切り替え・設定に保存） -->
        <ctrl:SoundToggleButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" />
    </Grid>
</Page>
