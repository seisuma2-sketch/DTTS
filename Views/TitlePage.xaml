<Page
    x:Class="DTTS.Views.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DTTS.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundDeepBrush}">

    <Grid>
        <!-- 背景アクセントグラデーション装飾 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Height="600" Opacity="0.08" CornerRadius="300" Background="{StaticResource AppAccentBrush}" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Spacing="24" Padding="24,40">
                
                <!-- タイトルロゴ領域 -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock
                        Text="DTTS"
                        FontSize="48"
                        FontWeight="ExtraBold"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource AppAccentBrush}"
                        CharacterSpacing="100" />
                    <TextBlock
                        Text="4-Player Daifugo Tabletop Suite"
                        FontSize="14"
                        FontWeight="Medium"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <!-- メインメニューボタン群 -->
                <StackPanel Spacing="12">
                    <Button
                        Command="{x:Bind ViewModel.StartSinglePlayerCommand}"
                        HorizontalAlignment="Stretch"
                        Height="52"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Background="{StaticResource AppAccentBrush}"
                        Foreground="{StaticResource AppOnAccentBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="♠" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="ひとりで対戦（NPC 3人）" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.OpenRuleSettingsCommand}"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Background="{StaticResource AppBackgroundElevatedBrush}"
                        Foreground="{StaticResource AppTextPrimaryBrush}"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="ルール ＆ 外見設定" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.OpenResultCommand}"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Background="{StaticResource AppBackgroundElevatedBrush}"
                        Foreground="{StaticResource AppTextPrimaryBrush}"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="通算戦績 ＆ 履歴" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.OpenHelpCommand}"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Background="{StaticResource AppBackgroundElevatedBrush}"
                        Foreground="{StaticResource AppTextPrimaryBrush}"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="❓" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="遊び方 ＆ ルール解説" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.OpenFeedbackCommand}"
                        HorizontalAlignment="Stretch"
                        Height="46"
                        CornerRadius="{StaticResource ButtonCornerRadius}"
                        Background="{StaticResource AppBackgroundElevatedBrush}"
                        Foreground="{StaticResource AppTextPrimaryBrush}"
                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="💬" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="フィードバック ＆ 要望" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- フッター -->
                <TextBlock
                    Text="v1.0.0 • Offline Ready"
                    FontSize="12"
                    Foreground="{StaticResource AppTextMutedBrush}"
                    HorizontalAlignment="Center" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
