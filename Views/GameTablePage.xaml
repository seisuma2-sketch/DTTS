<Page
    x:Class="DTTS.Views.GameTablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctrl="using:DTTS.Views.Controls"
    xmlns:vm="using:DTTS.ViewModels"
    xmlns:views="using:DTTS.Views"
    xmlns:pres="using:DTTS.Services.Presentation"
    xmlns:models="using:DTTS.Core.Models"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundDeepBrush}"
    Loaded="OnPageLoaded"
    PreviewKeyDown="OnPageKeyDown"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Grid x:Name="RootPageGrid">
        <!-- VisualStateManager による横フル画面 / 縦長コンパクトモードの自動切替 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <!-- 1. 横フル画面モード (幅960px以上: 4人囲み配置。800〜959px帯の場札衝突を防ぐ) -->
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OpponentRow.Visibility" Value="Collapsed" />
                        <Setter Target="TopSeatPanel.Visibility" Value="Visible" />
                        <Setter Target="LeftSeatPanel.Visibility" Value="Visible" />
                        <Setter Target="RightSeatPanel.Visibility" Value="Visible" />
                        <Setter Target="LeftColumn.Width" Value="240" />
                        <Setter Target="RightColumn.Width" Value="240" />
                        <!-- 操作ガイドは右の席の下の空き（出す・パスのボタンの上）に出し、場や状況表示に重ねない -->
                        <Setter Target="GuideHintBanner.(Grid.Column)" Value="2" />
                        <Setter Target="GuideHintBanner.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="GuideHintBanner.MaxWidth" Value="236" />
                        <Setter Target="GuideHintBanner.Margin" Value="4,0,0,4" />
                    </VisualState.Setters>
                </VisualState>

                <!-- 2. 縦長・コンパクトモード (幅800px未満: 上部3人スリム並び) -->
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OpponentRow.Visibility" Value="Visible" />
                        <Setter Target="TopSeatPanel.Visibility" Value="Collapsed" />
                        <Setter Target="LeftSeatPanel.Visibility" Value="Collapsed" />
                        <Setter Target="RightSeatPanel.Visibility" Value="Collapsed" />
                        <!-- 左右の相手パネルを出さないので、横の列は中身（ヘッダー）の幅だけにする -->
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                        <Setter Target="RightColumn.Width" Value="Auto" />
                        <!-- 自分の欄とボタンを手札の上の段にまとめ、手札は最下段の全幅にする -->
                        <Setter Target="Player0Panel.(Grid.Row)" Value="0" />
                        <Setter Target="ActionButtons.(Grid.Row)" Value="0" />
                        <Setter Target="ActionButtons.Orientation" Value="Horizontal" />
                        <Setter Target="ActionButtons.VerticalAlignment" Value="Center" />
                        <Setter Target="ActionButtons.Margin" Value="10,0,0,0" />
                        <Setter Target="HandScrollViewer.(Grid.Column)" Value="0" />
                        <Setter Target="HandScrollViewer.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="SuggestionBar.(Grid.Column)" Value="0" />
                        <Setter Target="SuggestionBar.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="SuggestionBar.HorizontalAlignment" Value="Right" />
                        <Setter Target="SuggestionBar.Margin" Value="0,-38,12,0" />
                        <Setter Target="SuggestionBar.MaxWidth" Value="440" />
                        <!-- 下の段が高くなる分、手札の上に浮かせる選択バーを持ち上げる -->
                        <Setter Target="CardSelectionBar.Margin" Value="16,0,16,300" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
            ゲーム卓：外側のリム（テーマカラーを淡く反射する二重の縁）と、
            中央がほんのり明るく外周ほど深くなるラジアルグラデーションのフェルト面
        -->
        <Border Margin="10" CornerRadius="30" BorderThickness="2" BorderBrush="{StaticResource AppAccentSubtleBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF2A3242" Offset="0" />
                    <GradientStop Color="#FF141922" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="TableFeltBorder" Margin="18" CornerRadius="24" BorderThickness="1.5" BorderBrush="#30FFFFFF">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.42" RadiusX="0.72" RadiusY="0.78">
                    <GradientStop x:Name="FeltStop0" Color="#FF223047" Offset="0" />
                    <GradientStop x:Name="FeltStop1" Color="#FF1D2636" Offset="0.38" />
                    <GradientStop x:Name="FeltStop2" Color="#FF151B26" Offset="0.78" />
                    <GradientStop x:Name="FeltStop3" Color="#FF0E121A" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- 内側のリムに沿う細いテーマカラーの線 -->
        <Border Margin="24" CornerRadius="19" BorderThickness="1" BorderBrush="{StaticResource AppAccentSubtleBrush}" IsHitTestVisible="False" />

        <!-- メイン対戦レイアウト -->
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="240" />
            </Grid.ColumnDefinitions>

            <!-- ヘッダー情報バー（1行目：戻る・ラウンド表示／2行目：サウンド・進行スピードの切り替え） -->
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        Click="OnTitleButtonClicked"
                        ToolTipService.ToolTip="タイトルに戻る（Esc / Alt+←）"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,4">
                        <TextBlock Text="← タイトル" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="13" />
                    </Button>
                    <TextBlock
                        Text="{x:Bind ViewModel.RoundInfoText, Mode=OneWay}"
                        Foreground="{StaticResource AppAccentBrush}"
                        FontWeight="Bold"
                        FontSize="14"
                        VerticalAlignment="Center" />
                </StackPanel>
                <!-- 2行目：サウンド・進行スピード・自動パス -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- サウンド ON/OFF（ワンクリックで切り替え・設定に保存） -->
                    <ctrl:SoundToggleButton IsTabStop="False" VerticalAlignment="Center" />
                    <!-- 進行スピード（クリックで ゆっくり → 普通 → 速い → 超速。すぐ反映して設定に保存） -->
                    <Button
                        Command="{x:Bind ViewModel.CycleSpeedCommand}"
                        Visibility="{x:Bind ViewModel.CanChangeSpeed, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SpeedToolTip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.SpeedToolTip, Mode=OneWay}"
                        IsTabStop="False"
                        Height="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEC4A;" FontSize="14" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 自動パス ON/OFF（対戦中いつでも切り替え・保存可能） -->
                    <Button
                        Command="{x:Bind ViewModel.ToggleAutoPassCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.AutoPassToolTip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.AutoPassToolTip, Mode=OneWay}"
                        IsTabStop="False"
                        Height="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AutoPassLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- 3行目：ルール変更・ひとこと・履歴（240px 列内に収めて見切れを防ぐ） -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- 親（ホスト・1人プレイ）による対戦中のルール変更 -->
                    <Button
                        Command="{x:Bind ViewModel.OpenInMatchRulesCommand}"
                        Visibility="{x:Bind ViewModel.CanEditRulesInMatch, Mode=OneWay}"
                        ToolTipService.ToolTip="対戦の途中でルールを変更します（親・ホストのみ）"
                        AutomationProperties.Name="ルール変更"
                        IsTabStop="False"
                        Height="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="ルール変更" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 定型リアクション送信 -->
                    <Button
                        x:Name="ReactionMenuButton"
                        ToolTipService.ToolTip="定型リアクションを送る"
                        AutomationProperties.Name="リアクション"
                        IsTabStop="False"
                        Height="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE8BD;" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="ひとこと" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="ReactionFlyout" Placement="Bottom" Opening="OnReactionFlyoutOpening">
                                <StackPanel Spacing="8" MinWidth="220">
                                    <ItemsControl x:Name="ReactionList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="pres:QuickReaction">
                                                <Button
                                                    Tag="{x:Bind Code}"
                                                    Click="OnQuickReactionClicked"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="10,7"
                                                    CornerRadius="8"
                                                    Background="#1FFFFFFF">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{StaticResource AppAccentBrush}" />
                                                        <TextBlock Text="{x:Bind Text}" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Background="#26FFFFFF" Margin="0,2" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="CustomReactionBox"
                                            PlaceholderText="自由に入力（40文字まで）"
                                            MaxLength="40"
                                            Text="{x:Bind ViewModel.CustomReactionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            KeyDown="OnCustomReactionKeyDown"
                                            CornerRadius="8"
                                            FontSize="12" />
                                        <Button
                                            Grid.Column="1"
                                            Click="OnSendCustomReactionClicked"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="{StaticResource AppAccentGradientBrush}"
                                            Foreground="{StaticResource AppOnAccentBrush}">
                                            <TextBlock Text="送信" FontSize="12" FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- プレイ履歴パネル開閉 -->
                    <Button
                        Click="OnToggleHistoryClicked"
                        ToolTipService.ToolTip="プレイ履歴（ログ）を表示・非表示"
                        AutomationProperties.Name="履歴"
                        IsTabStop="False"
                        Height="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="履歴" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 強弱・方向・状態バッジ（左上ヘッダーの下に常時表示し、中央はトランプ専用に広く使う） -->
                <StackPanel Spacing="5" Margin="4,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border CornerRadius="12" Padding="9,3" Background="#B3101520" BorderBrush="#33FFFFFF" BorderThickness="1"
                                ToolTipService.ToolTip="カードの強さの向き（弱い → 強い）">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="強さ" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.StrengthWeakText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE72A;" FontSize="10" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.StrengthStrongText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.StrengthCaption, Mode=OneWay}" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="12" Padding="9,3" Background="#B3101520" BorderBrush="#33FFFFFF" BorderThickness="1"
                                ToolTipService.ToolTip="手番の回る向き">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="{x:Bind ViewModel.DirectionGlyph, Mode=OneWay}" FontSize="11" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.DirectionText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 状態バッジ群 (革命 / 11バック / 縛り) -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            x:Name="RevolutionBadge"
                            CornerRadius="4"
                            Padding="7,2"
                            Background="#D03040"
                            Visibility="{x:Bind ViewModel.IsRevolution, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8AB;" FontSize="11" Foreground="#FFFFFF" />
                                <TextBlock Text="革命中" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="ElevenBackBadge"
                            CornerRadius="4"
                            Padding="7,2"
                            Background="#9040D0"
                            Visibility="{x:Bind ViewModel.IsElevenBack, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8EE;" FontSize="11" Foreground="#FFFFFF" />
                                <TextBlock Text="{x:Bind ViewModel.ElevenBackBadgeText, Mode=OneWay}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="LockBadge"
                            CornerRadius="4"
                            Padding="7,2"
                            Background="#E08020"
                            Visibility="{x:Bind ViewModel.LockDescription, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{x:Bind ViewModel.LockDescription, Mode=OneWay}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--
                相手の席は、座席順で自分の次の人から 左 → 上 → 右 の順に並べる（誰を出すかはコードで決める）。
                手番は画面上の時計回り（自分 → 左 → 上 → 右 → 自分）に進み、席替えのときも座席順に合わせて並べ直す。
            -->

            <!-- コンパクトモード用：上部3人並びパネル (幅800px未満で表示)。左から 左の席・向かい・右の席 -->
            <Grid x:Name="OpponentRow" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Visibility="Collapsed">
                <!-- 幅が足りないときは3人分をまとめて縮小して収める（はみ出して見切れないように） -->
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ctrl:PlayerPanelControl x:Name="LeftSeatSlimPanel" MinWidth="130" />
                        <ctrl:PlayerPanelControl x:Name="TopSeatSlimPanel" MinWidth="130" />
                        <ctrl:PlayerPanelControl x:Name="RightSeatSlimPanel" MinWidth="130" />
                    </StackPanel>
                </Viewbox>
            </Grid>

            <!-- 上（向かい：自分から2つ先の席。WideLayout時） -->
            <ctrl:PlayerPanelControl
                x:Name="TopSeatPanel"
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,12,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" />

            <!-- 左（自分の次に手番が来る席。WideLayout時） -->
            <ctrl:PlayerPanelControl
                x:Name="LeftSeatPanel"
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />

            <!-- 右（自分の前に手番が来る席。WideLayout時） -->
            <ctrl:PlayerPanelControl
                x:Name="RightSeatPanel"
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />

            <!-- 中央: 場 (Field) & 状態バッジ（割り込み確認が出る場合は下に余白を作り、場のトランプと重ならないようにする） -->
            <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Center">
                    <!-- 場札のマット（中央がわずかに明るい、二重縁の角丸マット）。ドラッグ＆ドロップで出す／少し位置移動が可能 -->
                    <Border
                        x:Name="FieldCardsContainer"
                        MinWidth="340"
                        MinHeight="186"
                        CornerRadius="28"
                        BorderBrush="{StaticResource AppAccentSubtleBrush}"
                        BorderThickness="1.5"
                        Padding="26,22"
                        AllowDrop="True"
                        DragOver="OnFieldDragOver"
                        Drop="OnFieldDrop"
                        DoubleTapped="OnFieldDoubleTapped"
                        ManipulationMode="TranslateX,TranslateY"
                        ManipulationDelta="OnFieldContainerManipulationDelta"
                        ToolTipService.ToolTip="手札からドラッグして出す／マットをドラッグして位置調整（ダブルクリックで位置リセット）">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="FieldContainerTransform" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.7">
                                <GradientStop Color="#40FFFFFF" Offset="0" />
                                <GradientStop Color="#18FFFFFF" Offset="0.55" />
                                <GradientStop Color="#08FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock
                                Text="場は流れています"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#8C96A8"
                                FontSize="14"
                                Visibility="{x:Bind ViewModel.FieldCards.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibleConverter}}" />

                            <!-- 前のカードは左上の数字とマークだけ見えるように重ねて置く -->
                            <ItemsControl x:Name="FieldCardsItemsControl" ItemsSource="{x:Bind ViewModel.FieldCards, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="-56" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ctrl:CardControl Card="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- ステータス案内メッセージ -->
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{StaticResource AppTextSecondaryBrush}" />

                    <!-- 直近の出来事（捨て札・12ボンバーの結果など。次の出来事まで残す） -->
                    <TextBlock
                        Text="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        MaxWidth="460"
                        MaxLines="2"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        TextAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppAccentBrush}" />
                </StackPanel>

                <!-- 割り込みの確認（8切りへの4止め／ろくろ首・99車への砂嵐）：場札の下の行に置き、トランプと絶対に被らないようにする -->
                <Border
                    x:Name="InterruptBar"
                    Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsInterruptPromptOpen, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Padding="16,10"
                    CornerRadius="14"
                    Background="{StaticResource AppBackgroundElevatedBrush}"
                    BorderBrush="#DAA520"
                    BorderThickness="1.5">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE945;" FontSize="20" Foreground="#DAA520" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="380">
                            <TextBlock Text="{x:Bind ViewModel.InterruptTitle, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.InterruptMessage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.InterruptMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Content="{x:Bind ViewModel.InterruptDeclineText, Mode=OneWay}"
                            MinWidth="104"
                            Height="38"
                            IsTabStop="False"
                            Command="{x:Bind ViewModel.PassCommand}"
                            IsEnabled="{x:Bind ViewModel.CanPass, Mode=OneWay}" />
                        <Button
                            Grid.Column="3"
                            Content="{x:Bind ViewModel.InterruptAcceptText, Mode=OneWay}"
                            MinWidth="140"
                            Height="38"
                            IsTabStop="False"
                            Command="{x:Bind ViewModel.PlaySelectedCardsCommand}"
                            IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}"
                            Background="{StaticResource AppAccentBrush}"
                            Foreground="{StaticResource AppOnAccentBrush}" />
                    </Grid>
                </Border>

                <!-- 自分があがった後、残りが NPC だけのとき：観戦をスキップして結果へ進む -->
                <Button
                    x:Name="SkipToResultButton"
                    Grid.Row="1"
                    Visibility="{x:Bind ViewModel.CanSkipToResult, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SkipToResultCommand}"
                    HorizontalAlignment="Center"
                    Height="42"
                    Padding="20,0"
                    CornerRadius="21"
                    IsTabStop="False"
                    Background="{StaticResource AppAccentBrush}"
                    Foreground="{StaticResource AppOnAccentBrush}"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    ToolTipService.ToolTip="残りの NPC どうしの対戦を待たずに進めて、ラウンド結果を表示します（S）"
                    AutomationProperties.Name="残りをスキップして結果へ">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEB9D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="残りをスキップして結果へ" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 操作ガイド（ヒント）。量は設定の「操作ガイド・確認レベル」で決まり、しばらくすると自動で消える。
                 場の表示がずれないよう重ねて出す（横フル画面では右の席の下、コンパクトでは中央の列の下端） -->
            <Border
                x:Name="GuideHintBanner"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,2"
                MaxWidth="520"
                Visibility="{x:Bind ViewModel.HasGuideHint, Mode=OneWay}"
                CornerRadius="10"
                Padding="12,7,6,7"
                Background="#E614202E"
                BorderBrush="#5579A8D8"
                BorderThickness="1"
                AutomationProperties.Name="操作ガイド"
                AutomationProperties.LiveSetting="Polite">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA80;" FontSize="14" Foreground="#FFE7C15A" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock
                        x:Name="GuideHintText"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.GuideHint, Mode=OneWay}"
                        TextWrapping="Wrap"
                        FontSize="12.5"
                        LineHeight="18"
                        Foreground="#FFDCE6F2"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="2"
                        Command="{x:Bind ViewModel.DismissGuideHintCommand}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        IsTabStop="False"
                        AutomationProperties.Name="ヒントを閉じる"
                        ToolTipService.ToolTip="ヒントを閉じる（設定の「操作ガイド」で出す量を変えられます）">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 下（自分） & 手札 & アクション操作 -->
            <!--
                横フル画面：[自分の欄][手札][ボタン] を1段に並べる。
                コンパクト：上の段に [自分の欄 … ボタン（横並び）]、最下段に手札を全幅で置く（狭い幅でも手札が収まる）
            -->
            <Grid x:Name="BottomArea" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 自プレイヤーパネル -->
                <ctrl:PlayerPanelControl
                    x:Name="Player0Panel"
                    Grid.Row="1"
                    Grid.Column="0"
                    ShowCardBacks="False"
                    VerticalAlignment="Bottom" />

                <!-- 自分のターン目印バッジ（自分の手番のときだけ手札の上にくっきり出す） -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,2"
                    Padding="14,4"
                    CornerRadius="12"
                    Background="{StaticResource AppAccentBrush}"
                    Visibility="{x:Bind ViewModel.IsMyTurn, Mode=OneWay}"
                    IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{StaticResource AppOnAccentBrush}" />
                        <TextBlock Text="あなたのターンです（クリックまたは場へドラッグして出す）" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppOnAccentBrush}" />
                    </StackPanel>
                </Border>

                <!-- 手札カード一覧 (クリックで選択、ドラッグで並び替え・場に出す)。自分のターンのときは枠を発光させる -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    CornerRadius="18"
                    Padding="4,2"
                    BorderThickness="2"
                    BorderBrush="{x:Bind views:GameTablePage.TurnHighlightBorder(ViewModel.IsMyTurn), Mode=OneWay}"
                    Background="{x:Bind views:GameTablePage.TurnHighlightBg(ViewModel.IsMyTurn), Mode=OneWay}">
                <ScrollViewer
                    x:Name="HandScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    SizeChanged="OnHandAreaSizeChanged">
                    <ItemsControl x:Name="HumanHandItemsControl" HorizontalAlignment="Center" ItemsSource="{x:Bind ViewModel.HumanHand, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="-20" Padding="20,22,20,4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CardViewModel">
                                <Grid
                                    CanDrag="True"
                                    AllowDrop="True"
                                    DragStarting="OnHandCardDragStarting"
                                    DragOver="OnHandCardDragOver"
                                    Drop="OnHandCardDrop">
                                    <ctrl:CardControl
                                        Card="{x:Bind Card}"
                                        IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
                                        CanPlay="{x:Bind CanPlay, Mode=OneWay}"
                                        IsKeyboardCursor="{x:Bind IsKeyboardCursor, Mode=OneWay}"
                                        IsLegalSelection="{x:Bind IsLegalSelection, Mode=OneWay}"
                                        CardClicked="OnCardClicked"
                                        CardDoubleClicked="OnCardDoubleClicked"
                                        SameRankRequested="OnCardSameRankRequested" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Border>

                <!--
                    まとめて選ぶ候補（今の場に出せるペア・3枚・階段）。押すとその組をまとめて選ぶ。
                    手札の上辺に重ねて浮かせ、出ていても手札や場の位置は動かさない。右クリック・長押しで同じ数字をまとめて選ぶこともできる
                -->
                <Border
                    x:Name="SuggestionBar"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,-36,0,0"
                    MaxWidth="660"
                    Padding="8,4"
                    CornerRadius="16"
                    Background="#D9101722"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.HasPlaySuggestions, Mode=OneWay}"
                    ToolTipService.ToolTip="押すとその組をまとめて選びます（カードの右クリック・長押しで同じ数字をまとめて選べます）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="まとめて選ぶ" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="2,0,2,0" />
                        <!-- 候補が多くて入りきらないときは、横にスクロールできる（スクロールバーは出さない） -->
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PlaySuggestionChips, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pres:PlaySuggestion">
                                    <Button
                                        Content="{x:Bind Label}"
                                        Tag="{x:Bind}"
                                        Click="OnSuggestionClicked"
                                        IsTabStop="False"
                                        Padding="10,2,10,3"
                                        MinHeight="0"
                                        CornerRadius="12"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="#26FFFFFF"
                                        BorderBrush="{StaticResource AppAccentBrush}"
                                        BorderThickness="1"
                                        Foreground="{StaticResource AppTextPrimaryBrush}"
                                        AutomationProperties.Name="{x:Bind Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 観戦モードバー（自分があがった後に他のプレイヤーの手札を切り替えて見る） -->
                <Border
                    x:Name="SpectateBar"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,-42,0,0"
                    Padding="12,6"
                    CornerRadius="16"
                    Background="#E6101722"
                    BorderBrush="{StaticResource AppAccentBrush}"
                    BorderThickness="1.2"
                    Visibility="{x:Bind ViewModel.IsSpectating, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE890;" FontSize="14" Foreground="{StaticResource AppAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SpectatingTitle, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SpectatablePlayers, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpectateTargetItem">
                                    <Button
                                        Tag="{x:Bind PlayerId}"
                                        Click="OnSpectateTargetClicked"
                                        IsTabStop="False"
                                        Padding="10,4"
                                        MinHeight="0"
                                        CornerRadius="12"
                                        FontSize="12"
                                        Background="{x:Bind views:GameTablePage.SpectateButtonBg(IsSelected)}"
                                        Foreground="{x:Bind views:GameTablePage.SpectateButtonFg(IsSelected)}"
                                        BorderBrush="{x:Bind views:GameTablePage.SpectateButtonBorder(IsSelected)}"
                                        BorderThickness="1.5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE890;" FontSize="11" Visibility="{x:Bind IsSelected}" />
                                            <TextBlock Text="{x:Bind views:GameTablePage.SpectateButtonText(Name, HandCount)}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 操作ボタン群 (出せない理由 / 整列・全解除 / パス / 出す) -->
                <StackPanel
                    x:Name="ActionButtons"
                    Grid.Row="1"
                    Grid.Column="2"
                    Spacing="8"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="14,0,0,4"
                    Visibility="{x:Bind ViewModel.IsSpectating, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <!-- 選んだ札が出せない理由の案内 -->
                    <Border
                        CornerRadius="10"
                        Padding="10,5"
                        MaxWidth="190"
                        HorizontalAlignment="Right"
                        Background="#CC2A151B"
                        BorderBrush="#88F48A94"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasPlayBlockedReason, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.PlayBlockedReason, Mode=OneWay}"
                            FontSize="11"
                            Foreground="#FFD4D8"
                            TextWrapping="Wrap"
                            TextAlignment="Right" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button
                            Command="{x:Bind ViewModel.SortHandCommand}"
                            ToolTipService.ToolTip="手札を並べ替え（強さ順 / スート順）"
                            Padding="10,5"
                            CornerRadius="14"
                            Background="#CC1A2130"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8CB;" FontSize="11" />
                                <TextBlock Text="整列" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{x:Bind ViewModel.ClearSelectionCommand}"
                            ToolTipService.ToolTip="選択をすべて解除（Cキー）"
                            Padding="10,5"
                            CornerRadius="14"
                            Background="#CC1A2130"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE894;" FontSize="11" />
                                <TextBlock Text="解除" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button
                        Command="{x:Bind ViewModel.PassCommand}"
                        IsEnabled="{x:Bind ViewModel.CanPass, Mode=OneWay}"
                        Width="124"
                        Height="42"
                        HorizontalAlignment="Right"
                        CornerRadius="21"
                        Background="#B318202E"
                        Foreground="{StaticResource AppTextPrimaryBrush}"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1.2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE711;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="パス" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="BS" FontSize="10" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Grid HorizontalAlignment="Right">
                        <!-- 押せるときの発光（テーマカラーの影） -->
                        <Border CornerRadius="29" Margin="-4" Background="{StaticResource AppAccentSubtleBrush}"
                                Visibility="{x:Bind ViewModel.CanPlay, Mode=OneWay}" IsHitTestVisible="False" />
                        <Button
                            Command="{x:Bind ViewModel.PlaySelectedCardsCommand}"
                            IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}"
                            Width="144"
                            Height="58"
                            CornerRadius="29"
                            Background="{StaticResource AppAccentGradientBrush}"
                            Foreground="{StaticResource AppOnAccentBrush}"
                            BorderBrush="#77FFFFFF"
                            BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE724;" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="出す" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="Enter" FontSize="10" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 全画面演出レイヤー（場流れ：四辺の光 / 12ボンバー・革命：斜めの光の帯）。操作は一切遮らない -->
        <Grid x:Name="SweepLayer" IsHitTestVisible="False">
            <Rectangle x:Name="PrismTop" Height="5" VerticalAlignment="Top" Opacity="0" Fill="{x:Bind PrismBrushHorizontal}" />
            <Rectangle x:Name="PrismBottom" Height="5" VerticalAlignment="Bottom" Opacity="0" Fill="{x:Bind PrismBrushHorizontal}" />
            <Rectangle x:Name="PrismLeft" Width="5" HorizontalAlignment="Left" Opacity="0" Fill="{x:Bind PrismBrushVertical}" />
            <Rectangle x:Name="PrismRight" Width="5" HorizontalAlignment="Right" Opacity="0" Fill="{x:Bind PrismBrushVertical}" />
            <Rectangle
                x:Name="AuroraBand"
                Width="520"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Margin="0,-240"
                Opacity="0"
                Fill="{x:Bind AuroraBrush}"
                RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="18" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!-- 判断要求ダイアログ（革命の選択・12ボンバーの数字宣言）：画面全体を暗くして答えを待つ -->
        <Border
            Background="#A0000000"
            Visibility="{x:Bind ViewModel.IsModalDecisionOpen, Mode=OneWay}">
            <Border
                Width="400"
                CornerRadius="16"
                Padding="24"
                Background="{StaticResource AppBackgroundElevatedBrush}"
                BorderBrush="{StaticResource AppBorderSubtleBrush}"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.DecisionTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.DecisionMessage, Mode=OneWay}" FontSize="14" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- 革命選択ボタン -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.IsRevolutionChoice, Mode=OneWay}">
                        <Button Content="起こさない [Esc]" Command="{x:Bind ViewModel.SubmitRevolutionDecisionCommand}" CommandParameter="{x:Bind FalseValue}" MinWidth="110" />
                        <Button Content="起こす [Enter]" Command="{x:Bind ViewModel.SubmitRevolutionDecisionCommand}" CommandParameter="{x:Bind TrueValue}" MinWidth="110" Background="{StaticResource AppAccentBrush}" Foreground="{StaticResource AppOnAccentBrush}" />
                    </StackPanel>

                    <!-- 12ボンバーの数字宣言：3〜2 と JK（ジョーカー）の14個のボタン（←/→ で移動、Space で選択、Enter で決定） -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsRankDeclaration, Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RankOptions, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" ItemWidth="48" ItemHeight="44" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RankOptionViewModel">
                                    <Button
                                        Width="42"
                                        Height="38"
                                        Padding="0"
                                        IsTabStop="False"
                                        Click="OnRankOptionClicked"
                                        Background="{x:Bind views:GameTablePage.RankBackground(IsSelected), Mode=OneWay}"
                                        Foreground="{x:Bind views:GameTablePage.RankForeground(IsSelected), Mode=OneWay}"
                                        BorderThickness="{x:Bind views:GameTablePage.CursorThickness(IsKeyboardCursor), Mode=OneWay}"
                                        BorderBrush="#FFF2C94C"
                                        AutomationProperties.Name="{x:Bind Label}">
                                        <TextBlock Text="{x:Bind Label}" FontSize="15" FontWeight="Bold" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectionCountText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <Button
                                Content="宣言する [Enter]"
                                HorizontalAlignment="Right"
                                MinWidth="130"
                                Height="38"
                                Command="{x:Bind ViewModel.SubmitRankDeclarationDecisionCommand}"
                                IsEnabled="{x:Bind ViewModel.CanConfirmDecision, Mode=OneWay}"
                                Background="{StaticResource AppAccentBrush}"
                                Foreground="{StaticResource AppOnAccentBrush}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!--
            カード選択（交換・7渡し・10捨て）の操作バー：画面を覆わず、手札の上に浮かせる。
            手札はマウスのクリック・ホバーでも、キーボード（←/→・Space）でも選べる
        -->
        <Border
            x:Name="CardSelectionBar"
            Visibility="{x:Bind ViewModel.IsCardSelectionMode, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="16,0,16,206"
            Padding="18,12"
            CornerRadius="14"
            Background="{StaticResource AppBackgroundElevatedBrush}"
            BorderBrush="{StaticResource AppAccentBrush}"
            BorderThickness="1.5">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="320">
                    <TextBlock Text="{x:Bind ViewModel.DecisionTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.DecisionMessage, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.SelectionCountText, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{StaticResource AppAccentBrush}" />
                <Button
                    Grid.Column="2"
                    Content="決定 [Enter]"
                    MinWidth="110"
                    Height="40"
                    IsTabStop="False"
                    Command="{x:Bind ViewModel.SubmitCardSelectionDecisionCommand}"
                    IsEnabled="{x:Bind ViewModel.CanConfirmDecision, Mode=OneWay}"
                    Background="{StaticResource AppAccentBrush}"
                    Foreground="{StaticResource AppOnAccentBrush}" />
            </Grid>
        </Border>

        <!--
            カード交換の結果（2ラウンド目以降）：渡したカード・受け取ったカードを小さなカードで数秒間見せる。
            対戦が始まった（最初の「出すかパスか」）ときに出し、6秒で消える。クリックでもすぐ閉じる
        -->
        <Button
            x:Name="ExchangeSummaryCard"
            Visibility="{x:Bind ViewModel.IsExchangeSummaryOpen, Mode=OneWay}"
            Command="{x:Bind ViewModel.DismissExchangeSummaryCommand}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="16,0,16,60"
            Padding="18,12,18,14"
            CornerRadius="14"
            Background="#F2161E2C"
            BorderBrush="{StaticResource AppAccentBrush}"
            BorderThickness="1.5"
            IsTabStop="False"
            AutomationProperties.Name="{x:Bind ViewModel.ExchangeSummaryText, Mode=OneWay}"
            ToolTipService.ToolTip="クリックで閉じる">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AB;" FontSize="16" Foreground="{StaticResource AppAccentBrush}" />
                    <TextBlock Text="カード交換の結果" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                </StackPanel>
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasExchangeGiven, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72A;" FontSize="12" Foreground="#FFF0A35E" />
                            <TextBlock Text="{x:Bind ViewModel.ExchangeGivenLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ExchangeGivenCards, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <ctrl:CardControl Card="{x:Bind}" Width="46" Height="67" IsHitTestVisible="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Visibility="{x:Bind ViewModel.HasExchangeReceived, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="#FF6FD39B" />
                            <TextBlock Text="{x:Bind ViewModel.ExchangeReceivedLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ExchangeReceivedCards, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <ctrl:CardControl Card="{x:Bind}" Width="46" Height="67" IsHitTestVisible="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Button>

        <!-- 検証用の自動プレイ中（起動引数 autoplay）であることの目印 -->
        <Border
            Visibility="{x:Bind ViewModel.IsAutoplay}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,6,18,0"
            Padding="10,2"
            CornerRadius="10"
            Background="#CC5B3FA8"
            IsHitTestVisible="False">
            <TextBlock Text="自動プレイ中（検証用）" FontSize="11" Foreground="White" />
        </Border>

        <!-- 元の InterruptBar / SkipToResultButton は中央グリッドへ移動済み -->

        <!--
            12ボンバーで消えた数字を、画面中央で弱い順に1つずつ見せる演出。
            カードがポンッと現れ、打ち消し線が入り、上へシュッと抜けて消える。操作は遮らない
        -->
        <Grid
            x:Name="BomberOverlay"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border HorizontalAlignment="Center" CornerRadius="12" Padding="14,4" Background="#E010131B" BorderBrush="#FF1493" BorderThickness="1">
                    <TextBlock x:Name="BomberHeaderText" Text="12ボンバー" FontSize="13" FontWeight="Bold" Foreground="#FF7AC0" />
                </Border>
                <StackPanel x:Name="BomberChipHost" Spacing="10" HorizontalAlignment="Center">
                    <Grid Width="132" Height="184" HorizontalAlignment="Center">
                        <Border CornerRadius="14" Background="#F7F8FB" BorderBrush="#FF1493" BorderThickness="3" />
                        <TextBlock x:Name="BomberChipCornerTop" Text="7" Margin="12,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" FontWeight="Bold" Foreground="#3A3D48" />
                        <TextBlock x:Name="BomberChipRank" Text="7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="78" FontWeight="Black" Foreground="#1C1D22" />
                        <TextBlock x:Name="BomberChipCornerBottom" Text="7" Margin="0,0,12,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="20" FontWeight="Bold" Foreground="#3A3D48" />
                        <Rectangle
                            x:Name="BomberStrike"
                            Width="170"
                            Height="6"
                            RadiusX="3"
                            RadiusY="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="#FF1493">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-34" CenterX="85" CenterY="3" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <Border HorizontalAlignment="Center" CornerRadius="10" Padding="12,3" Background="#E010131B">
                        <TextBlock x:Name="BomberCountText" Text="3枚 消滅" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ラウンド終了ダイアログ（構造化順位表） -->
        <Border
            Background="#B0000000"
            Visibility="{x:Bind ViewModel.IsRoundResultOpen, Mode=OneWay}">
            <Border
                x:Name="RoundResultCard"
                Width="460"
                CornerRadius="18"
                Padding="26"
                Background="{StaticResource AppBackgroundElevatedBrush}"
                BorderBrush="{StaticResource AppAccentBrush}"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="ラウンド結果" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" />
                    <Border CornerRadius="12" Background="#141822" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="12">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RoundResultRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoundResultRow">
                                    <Border Margin="0,3" Padding="12,8" CornerRadius="10" Background="{x:Bind views:GameTablePage.ResultRowBackground(IsMe)}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind views:GameTablePage.ResultPositionLabel(Position)}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind PlayerName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" CornerRadius="8" Padding="8,2" Background="#22FFFFFF" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind RankTitle}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{x:Bind PointsText}" FontSize="13" FontWeight="SemiBold" Foreground="#F2C94C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind TotalText}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Button
                        Content="{x:Bind ViewModel.NextRoundButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanAdvanceRound, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StartNextRoundCommand}"
                        HorizontalAlignment="Stretch"
                        Height="48"
                        FontSize="16"
                        FontWeight="Bold"
                        CornerRadius="24"
                        Background="{StaticResource AppAccentGradientBrush}"
                        Foreground="{StaticResource AppOnAccentBrush}"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 折りたたみ式 プレイ履歴パネル（右上） -->
        <Border
            x:Name="PlayHistoryPanel"
            Visibility="Collapsed"
            Width="300"
            MaxHeight="360"
            Margin="0,72,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="16"
            Padding="14"
            Background="#E6141923"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="プレイ履歴" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                    <Button Click="OnToggleHistoryClicked" HorizontalAlignment="Right" Padding="6,2" CornerRadius="8" Background="#1FFFFFFF">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PlayHistory, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlayHistoryEntry">
                                <Border Margin="0,2" Padding="8,4" CornerRadius="6" Background="#12FFFFFF">
                                    <TextBlock Text="{x:Bind Text}" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--
            あがりの演出：柔らかい光（プラチナ＋テーマカラー）と、中央から伸びる細い線、静かに浮かび上がる順位リボン。
            ラウンド結果の上にも出せるよう、結果ダイアログより後ろ（前面）に置く。操作は遮らない
        -->
        <Grid
            x:Name="FinishOverlay"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,170"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Ellipse x:Name="FinishGlow" Width="620" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                <Rectangle x:Name="FinishLineTop" Width="380" Height="1.5" HorizontalAlignment="Center" />
                <StackPanel x:Name="FinishRibbon" HorizontalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                        <TextBlock x:Name="FinishPlaceText" Text="1位" FontSize="36" FontWeight="SemiBold" CharacterSpacing="60" VerticalAlignment="Center" />
                        <TextBlock x:Name="FinishNameText" Text="あがり" FontSize="19" FontWeight="Medium" Foreground="#F2F4F8" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="FinishRankText" Text="大富豪" FontSize="12" FontWeight="SemiBold" CharacterSpacing="360" HorizontalAlignment="Center" Foreground="#C8CCD6" />
                </StackPanel>
                <Rectangle x:Name="FinishLineBottom" Width="380" Height="1.5" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 特殊効果・役通知（右上トースト通知：カードに被らないよう右上に表示） -->
        <Grid
            x:Name="CutInOverlay"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,24,0"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                x:Name="CutInBorder"
                MaxWidth="360"
                CornerRadius="14"
                Padding="16,12"
                BorderThickness="1.5"
                BorderBrush="#FFD700"
                Background="#EE101520">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="#22FFFFFF" VerticalAlignment="Center">
                        <FontIcon
                            x:Name="CutInIcon"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#FFD700"
                            Glyph="&#xE945;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="CutInTitleText"
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="#FFD700"
                                Text="革命" />
                            <TextBlock
                                x:Name="CutInSubText"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#AAAAAA"
                                VerticalAlignment="Center"
                                Text="SPECIAL EFFECT" />
                        </StackPanel>
                        <TextBlock
                            x:Name="CutInDetailText"
                            FontSize="12"
                            Foreground="#DDDDDD"
                            TextWrapping="Wrap"
                            Text="カードの強弱が逆転しました！" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 場へカードが飛ぶ演出の層：出したプレイヤーの席から場まで、カードの写しを画面の上で滑らせる
             （場の枠は角丸で中身を切り抜くため、枠の外を通る動きはこの層で描く）。クリックは下へ通す -->
        <Canvas x:Name="FlightLayer" IsHitTestVisible="False" />

        <!-- 親（ホスト・1人プレイ）による対戦中のルール変更オーバーレイ（最前面に出してトランプが上に被らないようにする） -->
        <Grid
            Visibility="{x:Bind ViewModel.IsInMatchRulesOpen, Mode=OneWay}"
            Background="#D8080C12">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="680"
                MaxHeight="640"
                Margin="24"
                Padding="22,18"
                CornerRadius="16"
                Background="{StaticResource AppBackgroundElevatedBrush}"
                BorderBrush="{StaticResource AppAccentBrush}"
                BorderThickness="1.5">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="対戦中のルール変更（親・ホスト）" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock Text="詳細設定（選択式ルール含む）を自由に変更でき、即座に反映されます（通信対戦時は全員に同期）。" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="プリセット:" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        <Button Content="シンプル" Command="{x:Bind ViewModel.ApplyInMatchPresetCommand}" CommandParameter="simple" />
                        <Button Content="標準" Command="{x:Bind ViewModel.ApplyInMatchPresetCommand}" CommandParameter="default" />
                        <Button Content="全部盛り" Command="{x:Bind ViewModel.ApplyInMatchPresetCommand}" CommandParameter="all" />
                        <Button Content="開発者用" Command="{x:Bind ViewModel.ApplyInMatchPresetCommand}" CommandParameter="dev" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.InMatchRuleCategories, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuleCategoryViewModel">
                                    <StackPanel Margin="0,0,0,14" Spacing="6">
                                        <TextBlock Text="{x:Bind Heading}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RuleToggleViewModel">
                                                    <Grid ColumnSpacing="8" Padding="4,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Label}" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                            <TextBlock Text="{x:Bind Hint}" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                                        </StackPanel>
                                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsOn, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{x:Bind Choices}" Visibility="{x:Bind HasChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RuleChoiceViewModel">
                                                    <Grid ColumnSpacing="10" Padding="4,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Label}" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                            <TextBlock Text="{x:Bind Hint}" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <ComboBox
                                                            Grid.Column="1"
                                                            ItemsSource="{x:Bind OptionLabels}"
                                                            SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                                                            MinWidth="190"
                                                            CornerRadius="8" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="キャンセル" Command="{x:Bind ViewModel.CancelInMatchRulesCommand}" MinWidth="100" />
                        <Button
                            Content="適用する"
                            Command="{x:Bind ViewModel.SaveInMatchRulesCommand}"
                            MinWidth="120"
                            Background="{StaticResource AppAccentBrush}"
                            Foreground="{StaticResource AppOnAccentBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
