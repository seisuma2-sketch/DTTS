<Page
    x:Class="DTTS.Views.RuleSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:DTTS.Services.Settings"
    xmlns:vm="using:DTTS.ViewModels"
    xmlns:views="using:DTTS.Views"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundDeepBrush}"
    Loaded="OnPageLoaded">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダーバー -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Command="{x:Bind ViewModel.GoBackCommand}" Background="Transparent" BorderThickness="0" Padding="8,4">
                    <TextBlock Text="← タイトルへ戻る" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="14" />
                </Button>
                <TextBlock Text="設定 ＆ カスタマイズ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.ResetRulesToDefaultCommand}"
                    Background="{StaticResource AppBackgroundElevatedBrush}"
                    BorderBrush="{StaticResource AppBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ButtonCornerRadius}">
                    <TextBlock Text="ルールを既定に戻す" FontSize="13" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.SaveAllCommand}"
                    Background="{StaticResource AppAccentBrush}"
                    Foreground="{StaticResource AppOnAccentBrush}"
                    CornerRadius="{StaticResource ButtonCornerRadius}">
                    <TextBlock Text="設定を保存" FontSize="13" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- メイン設定リスト -->
        <ScrollViewer Grid.Row="1" Padding="0,0,16,0">
            <StackPanel Spacing="24" MaxWidth="880" HorizontalAlignment="Left">

                <!-- ステータスメッセージ通知 -->
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Foreground="{StaticResource AppAccentBrush}"
                    FontSize="14"
                    FontWeight="Medium"
                    Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                <!-- 1. 外見設定（テーマカラー 8色 & スキン） -->
                <Border CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="テーマカラー（8色プリセット）" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        
                        <!-- 8色のカラーピッカーボタン -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="180" ItemHeight="44" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:ThemeColorInfo">
                                    <Button
                                        Click="OnThemeButtonClicked"
                                        Tag="{x:Bind Color}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Margin="4"
                                        CornerRadius="6"
                                        Background="#1E222B"
                                        BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{x:Bind AccentHex, Converter={StaticResource HexToBrushConverter}}" />
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- スキン着せ替え -->
                        <TextBlock Text="カードスキン設定" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Click="OnSelectDefaultSkinClicked" Background="#262A36" CornerRadius="6" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="標準ベクター描画を使用" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                            </Button>
                            <Button Click="OnImportZipClicked" Background="#262A36" CornerRadius="6" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1">
                                <TextBlock Text="ZIPからスキンパックをインポート..." FontSize="13" Foreground="{StaticResource AppAccentBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- サウンド（変更は即座に反映・保存） -->
                        <TextBlock Text="サウンド" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,8,0,0" />
                        <ToggleSwitch Header="効果音" IsOn="{x:Bind ViewModel.SoundEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider
                                Header="効果音の音量"
                                Width="320"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                TickFrequency="10"
                                Value="{x:Bind ViewModel.SeVolume, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}" />
                            <Button
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.PreviewSoundCommand}"
                                IsEnabled="{x:Bind ViewModel.SoundEnabled, Mode=OneWay}"
                                Background="#262A36"
                                CornerRadius="6"
                                BorderBrush="{StaticResource AppBorderSubtleBrush}"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="試聴" FontSize="13" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Slider
                            Header="BGM の音量（BGM は今後追加予定）"
                            Width="320"
                            HorizontalAlignment="Left"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            TickFrequency="10"
                            Value="{x:Bind ViewModel.BgmVolume, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 2. NPC（対戦相手）設定 -->
                <Border CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="NPC（CPU）設定" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                        
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 席1 (東) -->
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="席 1 (東)" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" />
                                <TextBox Header="名前" Text="{x:Bind ViewModel.Seat1Name, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 席2 (北) -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="席 2 (北)" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" />
                                <TextBox Header="名前" Text="{x:Bind ViewModel.Seat2Name, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- 席3 (西) -->
                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="席 3 (西)" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" />
                                <TextBox Header="名前" Text="{x:Bind ViewModel.Seat3Name, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. ローカルルール（カテゴリごとの折りたたみカード・2列のトグル・ワンクリックのプリセット） -->
                <Border CornerRadius="{StaticResource PanelCornerRadius}" Background="{StaticResource AppBackgroundElevatedBrush}" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="ローカルルール" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.RuleSummaryText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.SetAllCategoriesExpandedCommand}" CommandParameter="true" Background="Transparent" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="すべて開く">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.SetAllCategoriesExpandedCommand}" CommandParameter="false" Background="Transparent" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="すべて閉じる">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- プリセット（ワンクリックで全項目を切り替え） -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="プリセット" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.ApplyPresetCommand}" CommandParameter="Standard" CornerRadius="16" Padding="14,6" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Background="{StaticResource AppBackgroundDeepBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                                        <TextBlock Text="標準" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ApplyPresetCommand}" CommandParameter="Simple" CornerRadius="16" Padding="14,6" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Background="{StaticResource AppBackgroundDeepBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                        <TextBlock Text="シンプル" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ApplyPresetCommand}" CommandParameter="Chaos" CornerRadius="16" Padding="14,6" BorderBrush="{StaticResource AppBorderSubtleBrush}" BorderThickness="1" Background="{StaticResource AppBackgroundDeepBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE945;" FontSize="13" />
                                        <TextBlock Text="全部盛り" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- ラウンド数 -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="ラウンド数" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <NumberBox
                                Value="{x:Bind ViewModel.RoundCount, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="20"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Width="130" />
                        </StackPanel>

                        <!-- カテゴリごとの折りたたみカード -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RuleCategories, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuleCategoryViewModel">
                                    <Expander
                                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="12" Padding="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Heading}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Summary}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                                </StackPanel>
                                                <!-- 有効数バッジ（1つでも有効ならテーマカラー） -->
                                                <Border
                                                    Grid.Column="1"
                                                    CornerRadius="10"
                                                    Padding="10,2"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind views:RuleSettingsPage.BadgeBackground(HasEnabled), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind views:RuleSettingsPage.BadgeForeground(HasEnabled), Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <!-- 項目：幅に応じて1〜2列。1行＝名前・説明・スイッチ -->
                                        <ItemsRepeater ItemsSource="{x:Bind Items}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="300" MinItemHeight="56" MinColumnSpacing="16" MinRowSpacing="4" ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RuleToggleViewModel">
                                                    <Grid ColumnSpacing="8" Padding="4,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{x:Bind Label}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                            <TextBlock Text="{x:Bind Hint}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource AppTextMutedBrush}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            Grid.Column="1"
                                                            IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                            OnContent=""
                                                            OffContent=""
                                                            MinWidth="0"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{x:Bind Label}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
