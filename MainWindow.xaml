<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DTTS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DTTS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DTTS">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{StaticResource AppBackgroundDeepBrush}" KeyDown="OnRootKeyDown" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- 戻る操作：Alt+←（Alt の組み合わせは KeyDown に届かないためアクセラレータで受ける）。
             キーボードの「戻る」キーは XAML で VirtualKey 名を解釈できないため、OnRootKeyDown で判定する -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Frame x:Name="ContentFrame" />
    </Grid>
</Window>
